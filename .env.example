GEMINI_API_KEY=replace-with-your-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# Required before exposing the interview demo.
ALADDIN_DEMO_PASSWORD=replace-with-a-strong-demo-password
ALADDIN_API_TOKEN=replace-with-a-long-random-internal-token

# Single-process interview-demo safeguards. Set 0 to disable locally.
ALADDIN_RATE_LIMIT_PER_MINUTE=20
ALADDIN_MAX_GENERATIONS_PER_DAY=50
